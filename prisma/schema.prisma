// ============================================================
// GOAL ARENA — schema.prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ============================================================
// 1. USUARIOS Y PERFIL
// (mapea features/profile/type.ts -> Usuario, EstadisticasRapidas)
// ============================================================

model User {
  // OJO: este id ya NO se genera solo (antes era un cuid() aleatorio). Ahora
  // es el mismo id que crea Supabase Auth para la cuenta (un UUID), y se
  // asigna explícitamente al crear la fila justo después del alta en
  // Supabase Auth (ver src/app/api/auth/register/route.ts). Así una cuenta
  // = una fila de User, sin duplicar ni desincronizar los dos ids.
  id               String   @id
  email            String   @unique

  // Nombre de usuario -- único (se comprueba sin distinguir mayúsculas de
  // minúsculas desde la aplicación, ver src/app/api/auth/register/route.ts).
  // Es a la vez el nombre visible y el identificador para buscar/añadir
  // amigos y la URL del perfil público (/perfil/ese-nombre).
  nombre           String   @unique
  avatar           String   @default("⚽")
  avatarTipo       AvatarTipo @default(EMOJI)
  nivel            Int      @default(1)
  xpActual         Int      @default(0)
  xpSiguienteNivel Int      @default(100)
  createdAt        DateTime @default(now())

  // Se actualiza en cada "heartbeat" que manda el navegador mientras la app
  // está abierta (ver /api/heartbeat). Se considera "conectado" si esto es
  // reciente -- no es presencia en tiempo real, es una aproximación barata.
  ultimaActividad  DateTime?

  // Contadores denormalizados para no recalcular en cada carga de perfil
  partidasJugadas    Int @default(0)
  rachaActual        Int @default(0)
  rachaMaxima        Int @default(0)

  // Último momento (en UTC, como toda fecha en Postgres) en que se otorgó
  // el bonus de EXP por "primera victoria del día". Se compara contra el
  // día de calendario en España (no UTC) en src/lib/experiencia.ts --
  // null = todavía no se ha ganado nunca.
  ultimoBonusDiario DateTime?

  // Historial de partidas -- fuente real de "partidas jugadas por modo" y
  // "% de victoria por modo" en el perfil (ver src/app/api/perfil/
  // estadisticas/route.ts), y de paso el historial reciente.
  partidas PartidaJugada[]

  // Relaciones de amistad -- ver el modelo Friendship más abajo.
  solicitudesEnviadas  Friendship[] @relation("SolicitudesEnviadas")
  solicitudesRecibidas Friendship[] @relation("SolicitudesRecibidas")

  // Salas multijugador -- ver el modelo Sala más abajo.
  salasCreadas Sala[]        @relation("CreadorSala")
  salasUnidas  SalaJugador[]

  // Logros reclamados -- ver el modelo LogroReclamado más abajo.
  logrosReclamados LogroReclamado[]

  // Trofeos del modo competitivo (Grid Ranked, ver sección 4 más abajo) --
  // sistema totalmente aparte del nivel/EXP de siempre, ninguno de los dos
  // afecta al otro. La liga (Canterano/Amateur/.../Leyenda) no se guarda
  // aquí: se deriva de `trofeos` en caliente con `ligaPorTrofeos()`
  // (src/lib/trofeos.ts), igual que el nivel se deriva de la EXP -- así
  // cambiar los rangos de las ligas en el futuro no pide ninguna migración
  // ni recalcular nada guardado.
  trofeos Int @default(0)

  entradaCola     ColaRanked?
  historialTemporadas HistorialTemporada[]
}

// Logros -- el catálogo en sí (32 logros: nivel, amigos, partidas
// multijugador, victorias por juego, dificultad difícil, rachas y unos
// pocos especiales) vive en código (src/lib/logros.ts), NO en la base de
// datos: son fijos, y su progreso se calcula en caliente a partir de
// datos que ya existen (User.nivel, PartidaJugada, Friendship,
// User.rachaMaxima) -- no hay nada que "desbloquear y guardar", el
// desbloqueo es simplemente "¿tu contador ya llega al umbral?". Lo único
// que hace falta persistir de verdad es qué ha RECLAMADO cada usuario
// (una acción real, con una EXP real ya entregada) y cuándo.
model LogroReclamado {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Id estable del catálogo en código (p. ej. "nivel-10", "racha-20") --
  // no es una FK a una tabla de logros, porque no existe tal tabla.
  logroId String

  // Cuánta EXP dio al reclamarlo -- se guarda el valor de ESE momento
  // (no se recalcula si el día de mañana se cambia la recompensa de ese
  // logro en el catálogo; lo ya reclamado, reclamado está).
  expGanada Int

  reclamadoEn DateTime @default(now())

  // Un logro no se puede reclamar dos veces.
  @@unique([userId, logroId])
}

enum ResultadoPartidaJugada {
  VICTORIA
  DERROTA
}

// Una fila por partida terminada (victoria o derrota) en cualquier
// minijuego en solitario. `juego` es texto libre a propósito ("GRID",
// "TOP10"...) en vez de un enum -- el roadmap tiene 6 minijuegos
// planeados y añadir uno nuevo no debería pedir una migración solo para
// registrar sus partidas. La lista de valores válidos vive en código
// (src/lib/experiencia.ts), no en la base de datos.
model PartidaJugada {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  juego String // "GRID" | "TOP10" | "LINKPLAYERS"
  // Dificultad para GRID ("facil"|"medio"|"dificil"); null en juegos sin
  // modos, como TOP10 hoy.
  modo      String?
  resultado ResultadoPartidaJugada

  // Cuánta EXP dio esta partida en total (0 en derrota). Incluye el bonus
  // diario si aplicó -- para desglosarlo, ver `bonusDiario`.
  expGanada   Int     @default(0)
  bonusDiario Boolean @default(false)

  jugadaEn DateTime @default(now())

  // Perfil: agregados por modo ordenados por fecha, e historial reciente.
  @@index([userId, jugadaEn])
  @@index([userId, juego, modo])
}

enum AvatarTipo {
  EMOJI
  FOTO
}

enum EstadoAmistad {
  PENDIENTE
  ACEPTADA
}

// Una fila = una solicitud de amistad, en el estado que sea. "Sois amigos"
// significa "existe una fila entre A y B con estado ACEPTADA", sin
// importar quién la envió originalmente.
model Friendship {
  id             String        @id @default(cuid())
  solicitante    User          @relation("SolicitudesEnviadas", fields: [solicitanteId], references: [id], onDelete: Cascade)
  solicitanteId  String
  receptor       User          @relation("SolicitudesRecibidas", fields: [receptorId], references: [id], onDelete: Cascade)
  receptorId     String
  estado         EstadoAmistad @default(PENDIENTE)
  createdAt      DateTime      @default(now())
  respondidoEn   DateTime?

  // Evita que A pueda mandarle dos solicitudes a B. La solicitud en la
  // dirección contraria (B -> A) se resuelve a mano en la aplicación,
  // aceptando la existente en vez de crear una fila duplicada.
  @@unique([solicitanteId, receptorId])
  @@index([receptorId, estado])
}

// ============================================================
// 2. DATOS DE FÚTBOL (fuente: football-data.org + Wikipedia)
// (mapea features/games/shared/types.ts -> Jugador, Equipo)
// ============================================================

model Team {
  id         String   @id @default(cuid())
  externalId String?  @unique
  nombre     String
  pais       String
  escudo     String?

  // Si el equipo puede aparecer como fila/columna en el generador del
  // 3x3. Por defecto false -- hay que marcarlo explícitamente. No afecta
  // a si un jugador "cuenta" como perteneciente a este equipo, solo a
  // si el equipo es elegible para formar parte del tablero.
  elegibleParaGrid Boolean @default(false)

  stints         Stint[]
  playerStats    PlayerStat[]
  gridCeldas     Player[]      @relation("EquipoActual")

  // Top10 "de club" (ej. "Mayores traspasos del Real Madrid CF"), no
  // confundir con Top10Entry.equipoTexto -- eso es el equipo con el que
  // un jugador consiguió su registro, esto es DE QUÉ CLUB es el ranking
  // entero. Ver Top10Ranking.clubId más abajo.
  top10RankingsClub Top10Ranking[] @relation("Top10RankingClub")

  @@index([nombre])
  @@index([elegibleParaGrid])
}

model Player {
  id              String   @id @default(cuid())
  externalId      String?  @unique
  nombre          String
  fechaNacimiento DateTime? @db.Date
  nacionalidad    String
  imagenUrl       String?

  // Nombres alternativos aceptados al adivinar: "CR7", "Cristiano",
  // "Chicharito"... Sin esto, nadie acierta escribiendo el nombre corto.
  alias           String[] @default([])

  // Totales de carrera, para Higher/Lower y Top10 "globales"
  valorDeMercado  Float    @default(0) // en millones de €, ej: 45.5
  goles           Int      @default(0)
  asistencias     Int      @default(0)
  partidos        Int      @default(0)

  // Etapas por club, con fechas -> resuelve ADN, Fichajes, XI
  stints          Stint[]
  statsPorTemporada PlayerStat[]
  top10Entries    Top10Entry[]

  // Atajo desnormalizado: equipo actual, útil para mostrar en UI sin JOIN
  equipoActual    Team?    @relation("EquipoActual", fields: [equipoActualId], references: [id])
  equipoActualId  String?

  @@index([nombre])
  @@index([nacionalidad])
}

// Etapa de un jugador en un club, con fechas.
// Es lo que permite reconstruir el orden cronológico (ADN),
// una transferencia concreta (Fichajes) y la plantilla de un año (XI).
model Stint {
  id        String    @id @default(cuid())
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  team      Team      @relation(fields: [teamId], references: [id])
  teamId    String
  startDate DateTime
  endDate   DateTime? // null = etapa actual

  @@index([playerId, startDate])
  @@index([teamId, startDate])
}

model Competition {
  id         String   @id @default(cuid())
  externalId String?  @unique // id numérico de football-data.org
  codigo     String?  @unique // "PD", "PL", "CL"... clave estable entre API y datos manuales
  nombre     String            // "Champions League", "La Liga"...

  playerStats PlayerStat[]
  rankings    Top10Ranking[]
}

// Estadísticas de un jugador en una competición/temporada concreta.
// Necesario para Top10 ("máximos goleadores de la Champions")
// y para un Higher/Lower más fino que el total de carrera.
model PlayerStat {
  id            String      @id @default(cuid())
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId      String
  team          Team?       @relation(fields: [teamId], references: [id])
  teamId        String?
  competition   Competition @relation(fields: [competitionId], references: [id])
  competitionId String
  temporada     String      // "2023-24"

  goles         Int   @default(0)
  asistencias   Int   @default(0)
  partidos      Int   @default(0)
  valorDeMercado Float @default(0) // en millones de €

  @@unique([playerId, competitionId, temporada])
  @@index([competitionId, temporada])
}

// Qué métrica ordena el ranking. Hoy solo se usa GOLES, pero deja la
// puerta abierta a "Top 10 asistentes" o "Top 10 más caros" sin migrar.
enum Top10Metrica {
  GOLES
  ASISTENCIAS
  PARTIDOS
  VALOR_MERCADO
  EDAD
}

// Rankings precalculados para Top10, ya vengan de la API o escritos a mano
// (mapea features/games/top10/type.ts -> RankingTop10, EntradaTop10)
model Top10Ranking {
  id            String       @id @default(cuid())
  titulo        String       // "Máximos goleadores de La Liga 2012-13"
  descripcion   String?
  competition   Competition? @relation(fields: [competitionId], references: [id])
  competitionId String?

  // Sin temporada no puedes distinguir La Liga 2012 de La Liga 2013.
  // Nulo = ranking atemporal ("goleadores históricos de la Champions").
  temporada     String?                     // mismo formato que PlayerStat: "2012-13"
  metrica       Top10Metrica @default(GOLES)

  // Para rankings "de un club" (ej. "Mayores traspasos del Real Madrid CF"),
  // en vez de "de una competición entera". Null = ranking de competición,
  // comportamiento de siempre. Relación real a Team (no texto plano como
  // Top10Entry.equipoTexto) porque el club del ranking siempre existe como
  // Team de verdad -- si algún día hiciera falta un club que no está en la
  // BD, se da de alta como Team igual que cualquier otro.
  club          Team?        @relation("Top10RankingClub", fields: [clubId], references: [id])
  clubId        String?

  totalEntradas Int          @default(10)   // por si algún ranking es Top 5 o Top 20
  activo        Boolean      @default(true) // retirar un ranking sin borrarlo
  fuente        Top10Fuente  @default(API)  // de dónde salieron los datos
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  entradas Top10Entry[]

  // Evita duplicar el mismo ranking al reejecutar el script.
  // Ojo: en Postgres los NULL no colisionan entre sí, así que dos rankings
  // sin competición, sin temporada o sin club sí pueden coexistir. Es
  // intencionado -- así un Top10 "de competición" (clubId null) y varios
  // Top10 "de club" (cada uno con su clubId) pueden compartir la misma
  // competición/temporada/métrica sin chocar entre sí.
  @@unique([competitionId, temporada, metrica, clubId])
  @@index([activo])
  @@index([clubId])
}

enum Top10Fuente {
  API    // sincronizado desde football-data.org
  MANUAL // escrito a mano en data/top10/*.json
}

model Top10Entry {
  id        String       @id @default(cuid())
  ranking   Top10Ranking @relation(fields: [rankingId], references: [id], onDelete: Cascade)
  rankingId String
  posicion  Int
  player    Player       @relation(fields: [playerId], references: [id])
  playerId  String

  // El dato que justifica la posición: 46 goles, 21 asistencias, 180.5 M€...
  // Float en vez de Int para que valga también para valorDeMercado. Ojo:
  // el orden real de la tabla lo decide la POSICIÓN de cada entrada en el
  // JSON de origen (ver scripts/jugadores/syncTopScorers.ts), no este
  // número -- así que para métricas que no son un número simple (EDAD)
  // esto puede quedar como un valor auxiliar sin más pretensión que
  // rellenar el campo; lo que se enseña en pantalla es `valorTexto` si
  // existe.
  valor     Float        @default(0)

  // Texto formateado para mostrar en vez de `valor` cuando
  // un número plano no basta -- ej. "40 años, 4 meses y 17 días" para un
  // Top10 de "goleadores más veteranos". Null = se enseña `valor` tal
  // cual (comportamiento de siempre, ej. "(46)" goles).
  valorTexto String?

  // Con qué equipo consiguió ese registro. Texto plano a propósito: el
  // equipo histórico puede no existir como Team, y aquí solo se muestra.
  equipoTexto String?

  @@unique([rankingId, posicion])
  @@unique([rankingId, playerId]) // un jugador no sale dos veces en el mismo ranking
}

// ============================================================
// 3. PARTIDAS Y RONDAS (Individual / 1vs1 / Arena)
// ============================================================

enum EstadoSala {
  ESPERANDO // en la sala de espera, todavía no ha empezado
  EN_CURSO  // partida sincronizada en marcha
  FINALIZADA
  CANCELADA // el creador salió antes de empezar, o algo similar
}

// Una sala = una partida multijugador, de 2 a 8 jugadores, para cualquier
// minijuego que lo soporte (hoy solo GRID -- ver `juego`). Cubre tanto
// "1vs1" como "Arena" con el mismo modelo: 1vs1 es simplemente una sala
// con maxJugadores=2, no hay un modelo separado (decidido 05/08/2026).
model Sala {
  id     String @id @default(cuid())

  // 6 caracteres, sin ambigüedad visual (ver generarCodigoSala en
  // src/lib/salas.ts -- descarta 0/O, 1/I/L...). Es lo que se comparte
  // para "Unirse a sala".
  codigo String @unique

  creador   User   @relation("CreadorSala", fields: [creadorId], references: [id], onDelete: Cascade)
  creadorId String

  // Texto libre a propósito, mismo criterio que PartidaJugada.juego -- "GRID"
  // hoy, "TOP10" cuando se extienda el multijugador a ese modo (Fase 8/9).
  juego        String
  // Solo aplica a GRID ("facil"|"medio"|"dificil"); null en juegos sin
  // dificultad, mismo criterio que PartidaJugada.modo.
  dificultad   String?
  maxJugadores Int     @default(2) // 2-8, validado en la API, no aquí

  // true = esta Sala es una partida de Grid Ranked (1vs1 competitivo,
  // emparejada por el sistema, ver ColaRanked más abajo), no una Sala
  // casual creada por código -- por lo demás, es la MISMA Sala de siempre
  // (mismo tablero compartido, mismo timer, mismo polling). Al cerrarse,
  // `finalizarPartidaSiToca` reparte trofeos además de EXP cuando esto es
  // true (ver src/lib/trofeos.ts). Una Sala casual nunca lo tiene a true.
  competitiva Boolean @default(false)

  // Límite de tiempo de la partida en sí (no de la sala de espera), fijado
  // según la dificultad al crear la sala -- ver DURACION_RONDA_SEGUNDOS en
  // src/lib/salas.ts. Junto con `empezadaEn`, es la fuente única de verdad
  // del timer compartido: cada cliente calcula el tiempo restante como
  // empezadaEn + duracionSegundos - ahora, nunca con un cronómetro propio.
  duracionSegundos Int?

  estado EstadoSala @default(ESPERANDO)

  // Tablero (GRID) o ranking (TOP10, más adelante) ya fijado al crear la
  // sala -- generado UNA sola vez con el mismo generador que usa el modo
  // individual (generarTableroDesdeBD), y guardado tal cual para que todos
  // los jugadores vean EXACTAMENTE el mismo reto, en vez de que cada
  // cliente pida uno distinto como pasa en modo individual.
  contenido Json?

 // Momento exacto a partir del cual arranca de verdad el timer de la
  // ronda (cuenta atrás 3-2-1 ya incluida) -- fuente única de verdad para
  // el timer compartido, cada cliente calcula el tiempo restante contra
  // ESTE instante, no contra un cronómetro propio que arrancaría
  // desincronizado entre móviles.
  //
  // NULL mientras la sala está ESPERANDO, y TAMBIÉN durante un breve tramo
  // ya en EN_CURSO (12/08/2026, arreglo de sincronización): "Empezar
  // partida" marca `estado = EN_CURSO` pero deja `empezadaEn` en null
  // hasta que TODOS los jugadores confirman que ya cargaron la pantalla de
  // partida (ver `SalaJugador.cargado` y `marcarCargadoYArrancarCuentaAtrasSiToca`
  // en src/lib/salas.ts) -- así el 3-2-1 arranca de verdad a la vez para
  // todos, en vez de fijarse ya al pulsar el botón, momento en el que un
  // jugador con peor conexión podía tardar más en enterarse (por el
  // intervalo de polling de la sala de espera) y aterrizar en la pantalla
  // de partida con la cuenta atrás ya casi agotada.
  empezadaEn DateTime?

  // Momento exacto en que `estado` pasó a EN_CURSO (antes de que
  // `empezadaEn` se fije) -- solo sirve de ancla para el margen de
  // seguridad de la carga (ver SEGUNDOS_LIMITE_CARGA en src/lib/salas.ts):
  // si pasa demasiado tiempo sin que todos hayan cargado la pantalla de
  // partida (alguien cerró la pestaña, se le cortó la conexión...), la
  // cuenta atrás arranca igualmente con quien esté, en vez de dejar la
  // sala colgada para siempre.
  enCursoDesde DateTime?

  createdAt DateTime @default(now())

  jugadores SalaJugador[]

  @@index([estado])
}

// Quién está dentro de una sala (creador incluido) y si ha marcado
// "Listo". El creador empieza la partida cuando todos (él incluido) están
// listos.
model SalaJugador {
  id      String   @id @default(cuid())
  sala    Sala     @relation(fields: [salaId], references: [id], onDelete: Cascade)
  salaId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  listo   Boolean  @default(false)
  unidoEn DateTime @default(now())

  // A partir de aquí, todo lo que hace falta para la partida en sí --
  // vacío/en su valor por defecto mientras la sala está en ESPERANDO.

  // Casillas que ha resuelto ESTE jugador, en SU tablero -- cada jugador
  // juega el mismo reto (mismas condiciones, ver Sala.contenido) pero de
  // forma independiente, así que cada uno necesita su propio progreso.
  // Guardado como JSON: array de { fila, columna, jugador } (mismo tipo
  // `Jugador` que ya usa el modo individual). No se expone el detalle de
  // qué ha colocado un jugador a sus rivales mientras la partida está en
  // marcha -- solo el CONTADOR (ver `celdasResueltas`), para no dar pistas.
  progreso Json @default("[]")

  // Denormalizado a propósito, aunque sea derivable de `progreso.length`:
  // así el endpoint de polling (GET /api/salas/[codigo]/partida) puede
  // devolver el progreso de los rivales sin tener que parsear el JSON
  // completo de cada uno solo para contar cuántas casillas llevan.
  celdasResueltas Int @default(0)

  // Momento exacto en que este jugador completó las 9 casillas -- si
  // varios llegaran a completarlo (no debería poder pasar: la partida se
  // cierra en el servidor en cuanto el PRIMERO llega a 9), esto desempata
  // quién ganó de verdad.
  terminadaEn DateTime?

  // "VICTORIA" | "DERROTA" | "EMPATE" -- solo se rellena al finalizar la
  // partida (ver finalizarPartidaSiToca en src/lib/salas.ts). Null
  // mientras la partida sigue en marcha.
  resultado String?

  // Cuánta EXP dio esta partida multijugador, y con qué desglose (base,
  // bono de rapidez, bono diario, nivel de antes/después) -- mismo tipo
  // RespuestaPartida que ya usa el modo individual (ver src/lib/
  // experiencia.ts), guardado tal cual para poder reutilizar el mismo
  // componente de animación (ExperienciaGanada.tsx) en el cartel de
  // resultado del multijugador, sin reinventar esa pieza. Null mientras
  // la partida sigue en marcha.
  experiencia Json?

  // Confirma que este jugador ya cargó la pantalla de partida (12/08/2026,
  // arreglo de sincronización) -- se marca solo con que su cliente haga el
  // primer polling a GET /api/salas/[codigo]/partida (ver
  // marcarCargadoYArrancarCuentaAtrasSiToca en src/lib/salas.ts), sin
  // ninguna petición aparte. Cuando todos los de la sala lo tienen a
  // `true` (o se agota el margen de seguridad), el servidor fija
  // `Sala.empezadaEn` y ahí arranca la cuenta atrás 3-2-1 de verdad, a la
  // vez para todos. Se reinicia a `false` en cada revancha (ver
  // /api/salas/[codigo]/revancha), igual que el resto del progreso de la
  // ronda anterior.
  cargado Boolean @default(false)

  // Solo se rellenan en Salas competitivas (`Sala.competitiva = true`).
  // `trofeosAlEmpezar` es una FOTO del total de trofeos de este jugador en
  // el momento exacto en que se creó la Sala (al emparejar en la cola) --
  // se usa como base del cálculo Elo al cerrar la partida en vez de leer
  // `User.trofeos` en ese momento, para que el resultado sea determinista
  // aunque (por lo que sea) el valor de `User.trofeos` cambiase entre medias.
  // `trofeosCambio` es el +N/-N ya aplicado a `User.trofeos` al cerrar --
  // guardado aquí para poder pintarlo en el historial de partidas ranked
  // sin tener que recalcularlo.
  trofeosAlEmpezar Int?
  trofeosCambio    Int?

  // Un jugador no puede estar dos veces en la misma sala.
  @@unique([salaId, userId])
}

// ============================================================
// 4. MODO COMPETITIVO — Grid Ranked (Fase 9)
// ============================================================
//
// Diseño completo en el documento del proyecto "Modo competitivo (Fase 9)
// — Grid Ranked". Resumen: 1vs1 de Grid con matchmaking automático por
// trofeos (Elo simplificado, ver src/lib/trofeos.ts), organizado en
// temporadas. Reutiliza Sala/SalaJugador de la sección 3 casi tal cual --
// lo único nuevo de verdad es la cola de emparejamiento y las temporadas.

// Cola de emparejamiento de Grid Ranked. Una fila por usuario buscando
// partida ahora mismo -- se borra en cuanto se empareja (se crea la Sala
// competitiva) o el usuario cancela la búsqueda. Nunca es un historial,
// solo el estado "quién está buscando ahora mismo".
model ColaRanked {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique // no se puede estar en la cola dos veces a la vez

  // Foto de los trofeos en el momento de entrar en cola -- el rango de
  // rival aceptable (ver src/lib/trofeos.ts) se calcula contra esto, no
  // contra `User.trofeos` en vivo (aunque en la práctica no deberían
  // cambiar mientras se está en cola, al no poder jugar dos partidas a la
  // vez).
  trofeosEnCola Int

  entradaEn DateTime @default(now())

  // Para poder purgar entradas "fantasma" (pestaña cerrada sin cancelar
  // explícitamente) por antigüedad si hiciera falta más adelante.
  @@index([entradaEn])
}

// Una temporada del ladder competitivo. Al cerrarla (proceso manual al
// principio, igual que otras tareas administrativas del proyecto): se
// registra un `HistorialTemporada` por jugador con trofeos y se aplica el
// soft-reset (ver documento de diseño) antes de abrir la siguiente.
model Temporada {
  id          String    @id @default(cuid())
  numero      Int       @unique
  fechaInicio DateTime
  fechaFin    DateTime?
  activa      Boolean   @default(true)

  historial HistorialTemporada[]

  @@index([activa])
}

// Snapshot de cómo terminó cada jugador una temporada ya cerrada -- fuente
// de la insignia permanente de "mejor liga alcanzada" en el perfil (ver
// documento de diseño, sección de recompensas). Solo se crea al cerrar la
// temporada, nunca en caliente.
model HistorialTemporada {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  temporada   Temporada @relation(fields: [temporadaId], references: [id], onDelete: Cascade)
  temporadaId String

  trofeosFinales Int
  // Id estable de LIGAS en src/lib/trofeos.ts (p. ej. "PROFESIONAL"), no el
  // nombre visible -- así un cambio de naming en el futuro no rompe el
  // historial ya guardado.
  ligaFinal String

  creadoEn DateTime @default(now())

  // Un jugador solo puede tener un resultado por temporada.
  @@unique([userId, temporadaId])
}

